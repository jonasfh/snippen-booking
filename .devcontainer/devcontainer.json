{
  "name": "wp-dev-xdebug",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "args": {
      "USERNAME": "vscode",
      "USER_UID": "${localEnv:UID}",
      "USER_GID": "${localEnv:GID}"
    }
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind,consistency=cached",
  "forwardPorts": [
    8080,
    9003
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "xdebug.php-debug",
        "ms-azuretools.vscode-containers"
      ],
      "recommendations": [
        "google.google-antigravity"
      ]
    }
  },
  "containerEnv": {
    "WP_DEBUG": "1",
    "MYSQL_HOST": "localhost",
    "MYSQL_USER": "wpuser",
    "MYSQL_PWD": "wppass",
    "HTTP_HOST": "localhost"
  },
  "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.gemini; sudo bash /entrypoint.sh setup",
  "postStartCommand": "nohup sudo bash /entrypoint.sh > /tmp/wp-server.log 2>&1 &",
  "mounts": [
    "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,readonly",
    "source=${localWorkspaceFolderBasename}-gemini-data,target=/home/vscode/.gemini,type=volume",
    "source=${localWorkspaceFolder}/..,target=/workspaces,type=bind,consistency=cached"
  ],
  "remoteUser": "vscode"
}
