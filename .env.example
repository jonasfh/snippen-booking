# SMS Provider Selection ('keysms' or 'snippen_sms_service')
SMS_PROVIDER=snippen_sms_service

# KeySMS Settings (alternative SMS provider)
KEYSMS_USERNAME=
KEYSMS_API_KEY=
SMS_SENDER=Snippen
SMS_BOOKING_CONFIRMATION_ENABLED=yes
SMS_ACCOUNT_CONFIRMATION_ENABLED=yes

# Snippen SMS Service (Gateway / IoT Modem)
SNIPPEN_SMS_API_TOKEN=test-integration-token
SNIPPEN_SMS_SENDER=Snippen

# Test User Settings
TEST_USER_EMAIL=
TEST_USER_PHONE=
TEST_USER_NAME="Test User"
TEST_USER_PASS=passord123

# SMTP / Email Settings (e.g. Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Snippen Booking"

# Vipps MobilePay ePayment Settings
VIPPS_ENABLED=no
VIPPS_ENVIRONMENT=test
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MSN=
