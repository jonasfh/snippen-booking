{
    "name": "snippen/booking-plugin",
    "description": "Booking plugin for Snippen community house",
    "type": "wordpress-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Snippen",
            "email": "admin@snippen.com"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9",
        "wp-coding-standards/wpcs": "^3.0",
        "squizlabs/php_codesniffer": "^3.7",
        "phpstan/phpstan": "^1.0",
        "phpstan/extension-installer": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "SnippenBooking\\": "src/wp-content/plugins/booking-plugin/inc/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SnippenBooking\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:integration": "phpunit --testsuite=Integration",
        "demo:generate": "php bin/demo-data.php generate",
        "demo:clear": "php bin/demo-data.php clear",
        "lint": "phpcs --standard=WordPress src/wp-content/plugins/booking-plugin/inc/",
        "lint:fix": "phpcbf --standard=WordPress src/wp-content/plugins/booking-plugin/inc/"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
