{
    "name": "snippen/booking-plugin",
    "description": "Booking plugin for Snippen community house",
    "type": "wordpress-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Snippen",
            "email": "admin@snippen.com"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9",
        "wp-coding-standards/wpcs": "^3.0",
        "squizlabs/php_codesniffer": "^3.7",
        "phpstan/phpstan": "^1.0",
        "phpstan/extension-installer": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "SnippenBooking\\": "src/wp-content/plugins/booking-plugin/inc/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SnippenBooking\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:fast": "phpunit --testsuite=Unit --stop-on-failure",
        "test:integration": "phpunit --testsuite=Integration",
        "demo:bookings": "php bin/demo-data.php generate",
        "demo:wizard": "php bin/demo-data.php wizard",
        "demo:wizard2": "php bin/demo-data.php wizard2",
        "demo:clear": "php bin/demo-data.php clear",
        "demo:pages": "php bin/demo-pages.php",
        "demo:users": "php bin/demo-data.php users",
        "demo:sms": "php bin/demo-sms.php",
        "demo:mail": "php bin/demo-mail.php",
        "demo:notifications": "php bin/demo-notifications.php",
        "demo:templates": "php bin/demo-templates.php",
        "demo:payments": "php bin/demo-payments.php",
        "demo:reminders": "php bin/demo-payment-reminders.php",
        "demo:me": "php bin/demo-me.php",
        "demo:gateway": "php bin/demo-gateway.php",
        "demo:e2e": "@demo:gateway",
        "healthcheck": "bash bin/healthcheck.sh",
        "demo:env": [
            "@demo:sms",
            "@demo:mail"
        ],
        "demo": [
            "@demo:users",
            "@demo:bookings",
            "@demo:pages",
            "@demo:me",
            "@demo:env",
            "@demo:templates",
            "@demo:notifications",
            "@demo:payments",
            "@demo:mail"
        ],
        "demo:clean": "@demo:clear",
        "demo:reset": "@demo:clear",
        "lint": "phpcs",
        "lint:fix": "phpcbf"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
